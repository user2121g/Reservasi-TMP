<script>
  const ALL_SEATS = [
    'A1','A2','A3','A4','A5','A6','A7','A8','A9','A10',
    'A11','A12','A13','A14','A15','A16','A17','A18','A19','A20',
    'A21','A22','A23','A24','A25','A26',
    'B1','B2','B3','B4','B5','B6','B7','B8','B9','B10',
    'B11','B12','B13','B14','B15','B16','B17','B18','B19','B20',
    'B21','B22','B23','B24',
    'C1','C2','C3','C4','C5','C6','C7','C8','C9','C10',
    'C11','C12','C13','C14','C15','C16','C17','C18','C19','C20',
    'D1','D2','D3','D4','D5','D6'
  ];

  let seatsState = {};
  let selectedSeats = new Set();
  let currentZoom = 1;
  let activeFilter = 'all';

  let isDragging = false;
  let startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;

  function init() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('resDate').value = today;

    const saved = localStorage.getItem('the_music_place_seating_76');
    if (saved) {
      try {
        seatsState = JSON.parse(saved);
      } catch(e) {
        initDefaultSeats();
      }
    } else {
      initDefaultSeats();
    }

    ALL_SEATS.forEach(seatId => {
      if (!seatsState[seatId]) {
        seatsState[seatId] = {
          id: seatId,
          row: seatId[0],
          status: 'available',
          guestName: '',
          phone: '',
          pax: 1,
          date: today,
          time: '19:30',
          notes: ''
        };
      }
    });

    setupPanAndDrag();
    setupTooltips();
    updateUI();
  }

  function initDefaultSeats() {
    seatsState = {};
    const today = new Date().toISOString().split('T')[0];
    ALL_SEATS.forEach(seatId => {
      seatsState[seatId] = {
        id: seatId,
        row: seatId[0],
        status: 'available',
        guestName: '',
        phone: '',
        pax: 1,
        date: today,
        time: '19:30',
        notes: ''
      };
    });
  }

  function saveToStorage() {
    localStorage.setItem('the_music_place_seating_76', JSON.stringify(seatsState));
  }

  function toggleSeat(seatId) {
    if (selectedSeats.has(seatId)) {
      selectedSeats.delete(seatId);
    } else {
      selectedSeats.add(seatId);
      if (selectedSeats.size === 1 && seatsState[seatId].status === 'reserved') {
        const item = seatsState[seatId];
        document.getElementById('guestName').value = item.guestName || '';
        document.getElementById('guestPhone').value = item.phone || '';
        document.getElementById('paxCount').value = item.pax || 1;
        document.getElementById('resDate').value = item.date || document.getElementById('resDate').value;
        document.getElementById('resTime').value = item.time || '19:30';
        document.getElementById('resNotes').value = item.notes || '';
      }
    }
    if (selectedSeats.size > 0) {
      document.getElementById('paxCount').value = selectedSeats.size;
    }
    updateUI();
  }

  function selectRow(rowLetter) {
    ALL_SEATS.filter(s => s.startsWith(rowLetter)).forEach(s => selectedSeats.add(s));
    document.getElementById('paxCount').value = selectedSeats.size;
    updateUI();
  }

  function selectAllSeats() {
    ALL_SEATS.forEach(s => selectedSeats.add(s));
    document.getElementById('paxCount').value = selectedSeats.size;
    updateUI();
  }

  function clearSelection() {
    selectedSeats.clear();
    updateUI();
  }

  function applyReservation(newStatus) {
    if (selectedSeats.size === 0) {
      showToast('⚠️ Silakan klik dan pilih kursi pada denah terlebih dahulu!');
      return;
    }

    const name = document.getElementById('guestName').value.trim();
    const phone = document.getElementById('guestPhone').value.trim();
    const pax = parseInt(document.getElementById('paxCount').value) || selectedSeats.size;
    const date = document.getElementById('resDate').value;
    const time = document.getElementById('resTime').value;
    const notes = document.getElementById('resNotes').value.trim();

    if (newStatus === 'reserved' && !name) {
      showToast('⚠️ Masukkan Nama Pemesan untuk konfirmasi reservasi!');
      document.getElementById('guestName').focus();
      return;
    }

    selectedSeats.forEach(seatId => {
      seatsState[seatId] = {
        ...seatsState[seatId],
        status: newStatus,
        guestName: newStatus === 'reserved' ? name : (newStatus === 'blocked' ? 'BLOCKED / VIP' : ''),
        phone: newStatus === 'reserved' ? phone : '',
        pax: pax,
        date: date,
        time: time,
        notes: notes
      };
    });

    saveToStorage();
    const count = selectedSeats.size;
    selectedSeats.clear();
    updateUI();
    showToast(`✓ Berhasil memperbarui status ${count} kursi!`);
  }

  function releaseSelectedSeats() {
    if (selectedSeats.size === 0) {
      showToast('⚠️ Pilih kursi yang ingin di-release!');
      return;
    }

    selectedSeats.forEach(seatId => {
      seatsState[seatId] = {
        id: seatId,
        row: seatId[0],
        status: 'available',
        guestName: '',
        phone: '',
        pax: 1,
        date: '',
        time: '',
        notes: ''
      };
    });

    saveToStorage();
    const count = selectedSeats.size;
    selectedSeats.clear();
    document.getElementById('guestName').value = '';
    document.getElementById('guestPhone').value = '';
    document.getElementById('resNotes').value = '';
    updateUI();
    showToast(`🔓 ${count} kursi kembali Available!`);
  }

  function releaseSingleSeat(seatId) {
    seatsState[seatId] = {
      id: seatId,
      row: seatId[0],
      status: 'available',
      guestName: '',
      phone: '',
      pax: 1,
      date: '',
      time: '',
      notes: ''
    };
    saveToStorage();
    updateUI();
    showToast(`Kursi ${seatId} telah di-release.`);
  }

  function filterByStatus(status) {
    activeFilter = status;
    ALL_SEATS.forEach(seatId => {
      const el = document.getElementById(`seat-${seatId}`);
      if (!el) return;
      const curStatus = selectedSeats.has(seatId) ? 'selected' : seatsState[seatId].status;

      if (status === 'all' || curStatus === status) {
        el.classList.remove('dimmed');
      } else {
        el.classList.add('dimmed');
      }
    });
    showToast(status === 'all' ? 'Menampilkan semua kursi' : `Filter aktif: ${status.toUpperCase()}`);
  }

  function updateUI() {
    let avail = 0, reserved = 0, blocked = 0;

    ALL_SEATS.forEach(seatId => {
      const el = document.getElementById(`seat-${seatId}`);
      const data = seatsState[seatId];
      if (!el || !data) return;

      const isSelected = selectedSeats.has(seatId);

      if (isSelected) {
        el.setAttribute('data-status', 'selected');
      } else {
        el.setAttribute('data-status', data.status);
      }

      if (activeFilter !== 'all') {
        const curStatus = isSelected ? 'selected' : data.status;
        if (curStatus === activeFilter) {
          el.classList.remove('dimmed');
        } else {
          el.classList.add('dimmed');
        }
      } else {
        el.classList.remove('dimmed');
      }

      if (data.status === 'available') avail++;
      else if (data.status === 'reserved') reserved++;
      else if (data.status === 'blocked') blocked++;
    });

    document.getElementById('stat-avail').innerText = avail;
    document.getElementById('stat-selected').innerText = selectedSeats.size;
    document.getElementById('stat-reserved').innerText = reserved;
    document.getElementById('stat-blocked').innerText = blocked;

    const occPct = Math.round(((reserved + blocked) / 76) * 100);
    document.getElementById('occupancy-rate').innerText = `${occPct}%`;
    document.getElementById('occupancy-bar').style.width = `${occPct}%`;

    const badgeContainer = document.getElementById('selectedSeatsBadges');
    document.getElementById('selected-count-label').innerText = selectedSeats.size;
    document.getElementById('selected-summary-label').innerText = `${selectedSeats.size} Kursi Terpilih`;
    document.getElementById('mob-sel-cnt').innerText = selectedSeats.size;

    if (selectedSeats.size === 0) {
      badgeContainer.innerHTML = '<span style="color:#666; font-size:11px; align-self:center;">Klik kursi pada denah</span>';
      document.getElementById('floatingBar').classList.remove('show');
    } else {
      const sortedSeats = Array.from(selectedSeats).sort();
      badgeContainer.innerHTML = sortedSeats.map(s => `
        <span class="seat-badge">
          ${s}
          <span class="del-btn" onclick="event.stopPropagation(); toggleSeat('${s}')">&times;</span>
        </span>
      `).join('');
      
      document.getElementById('float-count').innerText = selectedSeats.size;
      document.getElementById('floatingBar').classList.add('show');
    }

    renderReservationsTable();
  }

  function renderReservationsTable() {
    const tbody = document.getElementById('bookingsTableBody');
    const search = (document.getElementById('searchBookings').value || '').toLowerCase().trim();

    let list = ALL_SEATS
      .map(id => seatsState[id])
      .filter(item => item && (item.status === 'reserved' || item.status === 'blocked'));

    if (search) {
      list = list.filter(item => 
        item.id.toLowerCase().includes(search) || 
        (item.guestName && item.guestName.toLowerCase().includes(search)) ||
        (item.phone && item.phone.toLowerCase().includes(search))
      );
    }

    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:#777; padding:10px;">Tidak ada reservasi yang sesuai.</td></tr>';
      return;
    }

    tbody.innerHTML = list.map(item => `
      <tr>
        <td><strong>${item.id}</strong></td>
        <td>${item.guestName || '-'}</td>
        <td>${item.pax || 1}</td>
        <td>
          <span style="color: ${item.status === 'reserved' ? '#ef4444' : '#888'}; font-weight:600;">
            ${item.status.toUpperCase()}
          </span>
        </td>
        <td>
          <button style="background:none; border:none; color:#ef4444; cursor:pointer; font-weight:bold; font-size:12px;" onclick="releaseSingleSeat('${item.id}')" title="Release seat">✖</button>
        </td>
      </tr>
    `).join('');
  }

  function switchMobileTab(tabContentId, btnEl) {
    document.querySelectorAll('.mobile-tab-nav .tab-btn').forEach(b => b.classList.remove('active'));
    btnEl.classList.add('active');

    document.querySelectorAll('.sidebar, .viewport-center').forEach(el => {
      el.classList.remove('active-tab-content');
    });

    const target = document.getElementById(tabContentId);
    if (target) {
      target.classList.add('active-tab-content');
    }
  }

  function focusReservationForm() {
    if (window.innerWidth <= 900) {
      const formTabBtn = document.querySelectorAll('.mobile-tab-nav .tab-btn')[1];
      switchMobileTab('sidebar-right', formTabBtn);
    }
    document.getElementById('guestName').focus();
  }

  function zoom(factor) {
    currentZoom *= factor;
    currentZoom = Math.min(Math.max(0.55, currentZoom), 2.5);
    document.getElementById('floorplan-wrapper').style.transform = `scale(${currentZoom})`;
  }

  function resetZoom() {
    currentZoom = 1;
    document.getElementById('floorplan-wrapper').style.transform = `scale(1)`;
  }

  function setupPanAndDrag() {
    const container = document.getElementById('panZoomContainer');
    
    container.addEventListener('mousedown', (e) => {
      if (e.target.closest('.interactive-seat')) return;
      isDragging = true;
      startX = e.pageX - container.offsetLeft;
      startY = e.pageY - container.offsetTop;
      scrollLeft = container.scrollLeft;
      scrollTop = container.scrollTop;
    });

    container.addEventListener('mouseleave', () => isDragging = false);
    container.addEventListener('mouseup', () => isDragging = false);

    container.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const y = e.pageY - container.offsetTop;
      const walkX = (x - startX) * 1.4;
      const walkY = (y - startY) * 1.4;
      container.scrollLeft = scrollLeft - walkX;
      container.scrollTop = scrollTop - walkY;
    });

    container.addEventListener('wheel', (e) => {
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        zoom(e.deltaY < 0 ? 1.1 : 0.9);
      }
    }, { passive: false });
  }

  function setupTooltips() {
    const tooltip = document.getElementById('seatTooltip');
    ALL_SEATS.forEach(seatId => {
      const el = document.getElementById(`seat-${seatId}`);
      if (!el) return;

      el.addEventListener('mouseenter', (e) => {
        const item = seatsState[seatId];
        const isSel = selectedSeats.has(seatId);
        let html = `<strong>Kursi ${seatId}</strong> (Row ${item.row})<br/>`;
        html += `Status: <span style="color:${isSel ? '#eab308' : (item.status === 'reserved' ? '#ef4444' : (item.status === 'available' ? '#22c55e' : '#888'))}; font-weight:bold;">${isSel ? 'SELECTED' : item.status.toUpperCase()}</span>`;
        if (item.status === 'reserved' && item.guestName) {
          html += `<br/>Guest: ${item.guestName} (${item.pax} Pax)`;
        }
        tooltip.innerHTML = html;
        tooltip.style.display = 'block';
      });

      el.addEventListener('mousemove', (e) => {
        tooltip.style.left = (e.clientX + 14) + 'px';
        tooltip.style.top = (e.clientY + 14) + 'px';
      });

      el.addEventListener('mouseleave', () => {
        tooltip.style.display = 'none';
      });
    });
  }

  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.innerText = msg;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 2600);
  }

  function resetAllData() {
    if (confirm('Reset seluruh data reservasi kembali ke kondisi awal (76 Kursi Available)?')) {
      localStorage.removeItem('the_music_place_seating_76');
      selectedSeats.clear();
      initDefaultSeats();
      updateUI();
      showToast('Semua reservasi berhasil di-reset.');
    }
  }

  function exportDataJSON() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(seatsState, null, 2));
    const dlAnchor = document.createElement('a');
    dlAnchor.setAttribute("href", dataStr);
    dlAnchor.setAttribute("download", `TheMusicPlace_76Seat_${new Date().toISOString().slice(0,10)}.json`);
    dlAnchor.click();
    showToast('Data reservasi berhasil di-export!');
  }

  function importDataJSON(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const imported = JSON.parse(e.target.result);
        if (typeof imported === 'object') {
          seatsState = imported;
          saveToStorage();
          selectedSeats.clear();
          updateUI();
          showToast('Data berhasil di-import dari JSON!');
        }
      } catch(err) {
        alert('File JSON tidak valid.');
      }
    };
    reader.readAsText(file);
  }

  window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>

                        <div>
                            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">No. WhatsApp/HP *</label>
                            <input type="tel" id="custPhone" placeholder="0812xxxx" class="w-full px-3 py-2 bg-[#1f1915] border border-[#3d2e26] rounded text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-[#d4af37]">
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Jumlah Pax *</label>
                            <input type="number" id="custPax" min="1" max="76" class="w-full px-3 py-2 bg-[#1f1915] border border-[#3d2e26] rounded text-sm text-gray-100 focus:outline-none focus:border-[#d4af37]">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Tanggal *</label>
                            <input type="date" id="resDate" class="w-full px-3 py-2 bg-[#1f1915] border border-[#3d2e26] rounded text-xs text-gray-100 focus:outline-none focus:border-[#d4af37]">
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Waktu *</label>
                            <input type="time" id="resTime" class="w-full px-3 py-2 bg-[#1f1915] border border-[#3d2e26] rounded text-xs text-gray-100 focus:outline-none focus:border-[#d4af37]">
                        </div>
                    </div>

                    <div>
                        <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Catatan / Special Request</label>
                        <textarea id="custNotes" rows="2" placeholder="VIP stage view, birthday setup, dsb." class="w-full px-3 py-2 bg-[#1f1915] border border-[#3d2e26] rounded text-xs text-gray-100 placeholder-gray-500 focus:outline-none focus:border-[#d4af37]"></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="space-y-2 pt-2">
                        <button type="button" onclick="applyReservation('Reserved')" class="w-full py-2.5 bg-[#d4af37] hover:bg-[#c39e2e] text-black font-bold text-xs uppercase tracking-wider rounded transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-check-circle text-sm"></i> Simpan & Reservasi
                        </button>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" onclick="applyReservation('Blocked')" class="py-2 bg-[#2d241f] hover:bg-[#3d312a] border border-[#4a3b32] text-gray-300 font-semibold text-xs rounded transition">
                                <i class="fa-solid fa-ban mr-1"></i> Block Kursi
                            </button>
                            <button type="button" onclick="releaseSelected()" class="py-2 bg-amber-950/40 hover:bg-amber-900/60 border border-amber-800/40 text-amber-300 font-semibold text-xs rounded transition">
                                <i class="fa-solid fa-rotate-left mr-1"></i> Release Seat
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Selected Seat Details Footer -->
            <div id="activeDetails" class="mt-4 p-3 bg-[#110d0b] border border-[#2b211a] rounded text-[11px] text-gray-400 space-y-1">
                <p class="font-bold text-[#e6c687] text-xs">Informasi Kursi Aktif</p>
                <p id="info-seat-details">Pilih kursi untuk melihat info detail reservasi pemesan.</p>
            </div>
        </aside>
    </div>

    <!-- Application Script -->
    <script>
        // Inisialisasi Data 76 Seat
        const ALL_SEATS = [
            // Row A: A1 - A26 (26 seats)
            ...Array.from({length: 26}, (_, i) => `A${i + 1}`),
            // Row B: B1 - B24 (24 seats)
            ...Array.from({length: 24}, (_, i) => `B${i + 1}`),
            // Row C: C1 - C20 (20 seats)
            ...Array.from({length: 20}, (_, i) => `C${i + 1}`),
            // Row D: D1 - D6 (6 seats)
            ...Array.from({length: 6}, (_, i) => `D${i + 1}`)
        ];

        let seatDatabase = {};
        let selectedSeats = new Set();
        let currentZoom = 1;

        // Inisialisasi Database
        function initApp() {
            // Set default date & time form
            const now = new Date();
            document.getElementById('resDate').value = now.toISOString().split('T')[0];
            document.getElementById('resTime').value = "19:00";

            // Load localStorage atau default
            const savedData = localStorage.getItem('TMP_SEATING_DATA_76');
            if (savedData) {
                try {
                    seatDatabase = JSON.parse(savedData);
                } catch (e) {
                    console.error("Gagal load data local:", e);
                    buildInitialDatabase();
                }
            } else {
                buildInitialDatabase();
            }

            renderAllSeats();
            updateStats();
        }

        function buildInitialDatabase() {
            seatDatabase = {};
            ALL_SEATS.forEach(id => {
                const row = id.charAt(0);
                seatDatabase[id] = {
                    id: id,
                    row: row,
                    status: 'Available', // Available, Reserved, Blocked
                    guestName: '',
                    phone: '',
                    pax: 1,
                    date: '',
                    time: '',
                    notes: '',
                    updatedAt: null
                };
            });
            saveToStorage();
        }

        function saveToStorage() {
            localStorage.setItem('TMP_SEATING_DATA_76', JSON.stringify(seatDatabase));
        }

        // Toggle Pilih Kursi
        function toggleSeat(seatId) {
            if (!seatDatabase[seatId]) return;

            if (selectedSeats.has(seatId)) {
                selectedSeats.delete(seatId);
            } else {
                selectedSeats.add(seatId);
            }

            renderSeatStyle(seatId);
            updateSelectedPanel();
            updateStats();
            showSeatDetails(seatId);
        }

        // Render Status Visual Kursi
        function renderSeatStyle(seatId) {
            const el = document.getElementById(`seat-${seatId}`);
            if (!el) return;

            el.classList.remove('available', 'selected', 'reserved', 'blocked');

            if (selectedSeats.has(seatId)) {
                el.classList.add('selected');
            } else {
                const status = seatDatabase[seatId].status.toLowerCase();
                el.classList.add(status);
            }
        }

        function renderAllSeats() {
            ALL_SEATS.forEach(id => renderSeatStyle(id));
            updateSelectedPanel();
            updateStats();
        }

        // Update Panel Sisi Kanan
        function updateSelectedPanel() {
            const container = document.getElementById('selected-seats-container');
            const countBadge = document.getElementById('selected-count-badge');
            const paxInput = document.getElementById('custPax');

            container.innerHTML = '';
            countBadge.innerText = `${selectedSeats.size} Kursi`;

            if (selectedSeats.size === 0) {
                container.innerHTML = `<span class="text-xs text-gray-500 italic">Klik kursi pada denah untuk memilih...</span>`;
                return;
            }

            paxInput.value = selectedSeats.size;

            Array.from(selectedSeats).sort().forEach(id => {
                const tag = document.createElement('span');
                tag.className = 'px-2 py-0.5 bg-[#d4af37]/20 border border-[#d4af37]/50 text-[#e6c687] text-xs rounded font-bold flex items-center gap-1';
                tag.innerHTML = `${id} <i class="fa-solid fa-xmark text-[10px] cursor-pointer hover:text-red-400" onclick="event.stopPropagation(); toggleSeat('${id}')"></i>`;
                container.appendChild(tag);
            });
        }

        // Quick Selector Row
        function selectRow(rowLetter) {
            const rowSeats = ALL_SEATS.filter(id => id.startsWith(rowLetter));
            const allAlready = rowSeats.every(id => selectedSeats.has(id));

            rowSeats.forEach(id => {
                if (allAlready) {
                    selectedSeats.delete(id);
                } else {
                    selectedSeats.add(id);
                }
                renderSeatStyle(id);
            });
            updateSelectedPanel();
            updateStats();
        }

        function selectAll() {
            ALL_SEATS.forEach(id => {
                selectedSeats.add(id);
                renderSeatStyle(id);
            });
            updateSelectedPanel();
            updateStats();
        }

        function clearSelection() {
            selectedSeats.clear();
            renderAllSeats();
        }

        // Reservasi & Block Action
        function applyReservation(newStatus) {
            if (selectedSeats.size === 0) {
                alert("Silakan pilih minimal 1 kursi pada denah layout!");
                return;
            }

            const name = document.getElementById('custName').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const pax = document.getElementById('custPax').value || selectedSeats.size;
            const date = document.getElementById('resDate').value;
            const time = document.getElementById('resTime').value;
            const notes = document.getElementById('custNotes').value.trim();

            if (newStatus === 'Reserved' && !name) {
                alert("Harap masukkan Nama Pemesan untuk melakukan reservasi!");
                document.getElementById('custName').focus();
                return;
            }

            selectedSeats.forEach(id => {
                seatDatabase[id] = {
                    ...seatDatabase[id],
                    status: newStatus,
                    guestName: newStatus === 'Reserved' ? name : 'BLOCKED',
                    phone: newStatus === 'Reserved' ? phone : '-',
                    pax: pax,
                    date: date,
                    time: time,
                    notes: notes,
                    updatedAt: new Date().toLocaleString('id-ID')
                };
            });

            saveToStorage();
            selectedSeats.clear();
            renderAllSeats();

            // Reset Input Form
            document.getElementById('custName').value = '';
            document.getElementById('custPhone').value = '';
            document.getElementById('custNotes').value = '';

            alert(`Berhasil menyimpan status ${newStatus} untuk ${pax} pax!`);
        }

        // Release / Batal Reservasi
        function releaseSelected() {
            if (selectedSeats.size === 0) {
                alert("Pilih kursi yang ingin di-release / dibatalkan!");
                return;
            }

            if (confirm(`Kembalikan ${selectedSeats.size} kursi yang dipilih menjadi Available?`)) {
                selectedSeats.forEach(id => {
                    seatDatabase[id] = {
                        id: id,
                        row: id.charAt(0),
                        status: 'Available',
                        guestName: '',
                        phone: '',
                        pax: 1,
                        date: '',
                        time: '',
                        notes: '',
                        updatedAt: null
                    };
                });
                saveToStorage();
                selectedSeats.clear();
                renderAllSeats();
            }
        }

        function resetAllReservations() {
            if (confirm("PERINGATAN: Apakah Anda yakin ingin mereset seluruh denah menjadi 100% Available?")) {
                buildInitialDatabase();
                selectedSeats.clear();
                renderAllSeats();
            }
        }

        // Detail Popup / Footer Info
        function showSeatDetails(seatId) {
            const data = seatDatabase[seatId];
            const infoBox = document.getElementById('info-seat-details');
            if (!data) return;

            if (data.status === 'Available') {
                infoBox.innerHTML = `<strong class="text-emerald-400 font-bold">${seatId}</strong>: Tersedia (Available).`;
            } else {
                infoBox.innerHTML = `
                    <div class="space-y-0.5">
                        <p><strong class="text-[#e6c687]">${seatId}</strong> &bull; Status: <span class="${data.status === 'Reserved' ? 'text-red-400' : 'text-gray-400'} font-bold">${data.status}</span></p>
                        <p><strong>Nama:</strong> ${data.guestName || '-'}</p>
                        <p><strong>Kontak:</strong> ${data.phone || '-'}</p>
                        <p><strong>Jadwal:</strong> ${data.date || '-'} (${data.time || '-'})</p>
                        ${data.notes ? `<p><strong>Catatan:</strong> ${data.notes}</p>` : ''}
                    </div>
                `;
            }
        }

        // Update Counter Metrik
        function updateStats() {
            let reservedCount = 0;
            let blockedCount = 0;
            let availableCount = 0;

            Object.values(seatDatabase).forEach(seat => {
                if (seat.status === 'Reserved') reservedCount++;
                else if (seat.status === 'Blocked') blockedCount++;
                else availableCount++;
            });

            document.getElementById('stat-available').innerText = availableCount;
            document.getElementById('stat-selected').innerText = selectedSeats.size;
            document.getElementById('stat-reserved').innerText = reservedCount + (blockedCount > 0 ? ` (+${blockedCount})` : '');
            
            const occupancy = Math.round(((reservedCount + blockedCount) / 76) * 100);
            document.getElementById('stat-occupancy').innerText = `${occupancy}%`;
        }

        // Zoom Viewport Handlers
        function zoom(delta) {
            currentZoom = Math.min(Math.max(0.6, currentZoom + delta), 2.2);
            document.getElementById('venueFloorplan').style.transform = `scale(${currentZoom})`;
        }

        function resetZoom() {
            currentZoom = 1;
            document.getElementById('venueFloorplan').style.transform = `scale(1)`;
        }

        // Export & Import JSON
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(seatDatabase, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `TMP_Reservation_76_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importData(event) {
            const fileReader = new FileReader();
            fileReader.onload = function() {
                try {
                    const parsed = JSON.parse(fileReader.result);
                    if (Object.keys(parsed).length >= 76) {
                        seatDatabase = parsed;
                        saveToStorage();
                        selectedSeats.clear();
                        renderAllSeats();
                        alert("Data reservasi berhasil di-import!");
                    } else {
                        alert("File JSON tidak sesuai struktur 76 kursi venue.");
                    }
                } catch (err) {
                    alert("Format file JSON tidak valid.");
                }
            };
            fileReader.readAsText(event.target.files[0]);
        }

        // Start App on Load
        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
